@model List<RealEstateWebApp.Models.City>
@using RealEstateWebApp.Models
@using Microsoft.AspNetCore.Identity
@inject SignInManager<ApplicationUser> SignInManager
@{
    Layout = null;
}

<!doctype html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>SYRELIS | العقارات الفاخرة في سوريا</title>

    <link href="https://fonts.googleapis.com/css2?family=Tajawal:wght@300;400;500;700;800&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" />
    <link rel="stylesheet" href="~/css/index.css" />

    <style>
        .btn-primary {
            background: linear-gradient(135deg, #d4af37, #b8941f);
            color: #0b1320;
            padding: 12px 26px;
            border: none;
            border-radius: 0px;
            font-family: 'Tajawal', sans-serif;
            font-size: 0.98rem;
            font-weight: 700;
            cursor: pointer;
            display: inline-flex;
            align-items: center;
            gap: 7px;
            text-decoration: none;
            transition: 0.3s;
        }

            .btn-primary:hover {
                background: linear-gradient(135deg, #b8941f, #d4af37);
                transform: translateY(-2px);
                box-shadow: 0 4px 20px rgba(212, 175, 55, 0.4);
            }

        .btn-outline {
            background: transparent;
            border: 2px solid #d4af37;
            color: #d4af37;
            padding: 12px 26px;
            border-radius: 0px;
            font-family: 'Tajawal', sans-serif;
            font-size: 0.98rem;
            font-weight: 700;
            cursor: pointer;
            display: inline-flex;
            align-items: center;
            gap: 7px;
            text-decoration: none;
            transition: 0.3s;
        }

            .btn-outline:hover {
                background: #d4af37;
                color: #0b1320;
                transform: translateY(-2px);
                box-shadow: 0 4px 20px rgba(212, 175, 55, 0.3);
            }
    </style>
</head>
<body>

    <nav class="navbar">
        <img class="logo" src="~/image/hero.png" alt="SYRELIS Logo" />
        <ul class="nav-links">
            <li><a href="@Url.Action("Create", "Properties")" id="announceLink"><span class="link_span">أعلن عن عقارك</span></a></li>
            <li><a href="@Url.Action("Index", "Search")" id="searchLink"><span class="link_span">ابحث عن عقارك</span></a></li>
            <li><a href="@Url.Action("MyFavorites", "Properties")" id="myAccountLink"><span class="link_span">محفوظاتي</span></a></li>
            <li><a href="/Home/Index?skipRedirect=true#contactSection" id="contactNavLink"><span class="link_span">تواصل معنا</span></a></li>
        </ul>

        @if (SignInManager.IsSignedIn(User))
        {
            <button class="login-btn-nav" id="openModalBtn">
                <i class="fas fa-sign-out-alt"></i> تسجيل الخروج
            </button>
        }
        else
        {
            <button class="login-btn-nav" id="openModalBtn">
                <i class="fas fa-sign-in-alt"></i> تسجيل الدخول
            </button>
        }
    </nav>

    <section class="hero">
        <div class="hero-content">
            <h1>منزل <span>أحلامك</span><br />يبدأ من SYRELIS</h1>
            <p>أكبر منصة عقارية فاخرة في سوريا – أكثر من 10,000 عقار حصري بثقة وأمان كامل</p>
            <div>
                <a href="#citiesContainer" class="btn-primary">
                    <i class="fa-solid fa-building"></i> استكشف العقارات
                </a>
                <a href="@Url.Action("All", "PropertyRequest")" class="btn-outline" id="requestsBtn">
                    <i class="fa-solid fa-list"></i> العقارات المطلوبة
                </a>
            </div>
        </div>
    </section>

    <section class="featured">
        <div class="container">
            <h2 class="section-title">
                عقارات <span style="font-size: 43px">Syrelis</span>
            </h2>
            <div class="cards-grid" id="citiesGrid"></div>
        </div>

        <div class="container-cities" id="citiesContainer">
            @if (Model != null && Model.Any())
            {
                foreach (var city in Model)
                {
                    <div class="container-city" data-city="@city.NameAr" onclick="window.location.href='@Url.Action("City", "PropertiesByCity", new { cityName = city.NameAr })'">
                        <img src="~/image/@(city.NameAr).jpg" alt="@city.NameAr" onerror="this.src='~/image/default-city.jpg'" />
                        <div class="overlay"></div>
                        <div class="city">@city.NameAr</div>
                    </div>
                }
            }
            else
            {
                <p style="grid-column: span 4; text-align:center; color:gray; padding:40px 0;">
                    ⚠️ لا توجد مدن مضافة في قاعدة البيانات بعد.
                </p>
            }
        </div>
    </section>

    <section class="contact-section" id="contactSection">
        <div class="contact-grid">
            <div class="contact-info">
                <h3><i class="fas fa-crown"></i> SYRELIS</h3>
                <p>منصة العقارات الفاخرة الرائدة في سوريا.</p>
                <div class="contact-detail">
                    <i class="fas fa-map-marker-alt"></i>
                    <span>دمشق – برج سيريليس، شارع المالكي</span>
                </div>
                <div class="contact-detail">
                    <i class="fas fa-phone-alt"></i>
                    <span>+963 11 234 5678</span>
                </div>
                <div class="contact-detail">
                    <i class="fas fa-envelope"></i>
                    <span>info@syrelis.com</span>
                </div>
                <div class="contact-detail">
                    <i class="fas fa-clock"></i>
                    <span>الأحد – الخميس: 9ص – 8م</span>
                </div>
            </div>
        </div>
    </section>

    <footer class="footer">
        <div class="footer-content">
            <div class="footer-logo">SYRELIS</div>
            <div class="footer-copyright">© 2026 SYRELIS – جميع الحقوق محفوظة</div>
            <div class="footer-social">
                <a href="https://www.instagram.com/"><i class="fab fa-instagram"></i></a>
                <a href="https://www.facebook.com/"><i class="fab fa-facebook-f"></i></a>
                <a href="https://www.linkedin.com/"><i class="fab fa-linkedin-in"></i></a>
            </div>
        </div>
    </footer>

    @Html.AntiForgeryToken()

</body>
</html>