                        <path d="m5.9 13.6 1.1-.9h7.8l1.2.9" fill="#ce592c"/>
                        <ellipse cx="10.9" cy="13.1" rx="2.7" ry=".3" fill="#ce592c" opacity=".5"/>
                        <path d="m20.6 26.1-2.9-11.3a1.71 1.71 0 00-1.6-1.2H5.7a1.69 1.69 0 00-1.5 1.3L1.1 26.2a.61.61 0 00.3.7l1.1.4a.61.61 0 00.7-.3l2.7-6.7.2 16.8h3.6l.6-9.3a.47.47 0 01.44-.5h.06c.4 0 .4.2.5.5l.6 9.3h3.6l.2-16.8 2.5 6.6a.52.52 0 00.66.31l1.2-.4a.57.57 0 00.5-.7Z" fill="#fdbf2d"/>
                        <circle cx="10.9" cy="7" r="5.9" fill="#fdbf2d"/>
                    </svg>`;

            var pegmanIcon = L.divIcon({
                className: 'pegman-marker',
                html: pegmanSVG,
                iconSize: [44, 44],
                iconAnchor: [22, 42]
            });

            // التحقق من أن الموقع داخل سوريا
            if (!isInsideSyria(defaultLat, defaultLng)) {
                defaultLat = 33.5138;
                defaultLng = 36.2765;
                if (defaultLat !== @Model.Latitude?.ToString("F6")) {
                    document.getElementById('editLatDisplay').value = defaultLat.toFixed(6);
                    document.getElementById('editLngDisplay').value = defaultLng.toFixed(6);
                    document.getElementById('editLat').value = defaultLat;
                    document.getElementById('editLng').value = defaultLng;
                }
            }

            editMarker = L.marker([defaultLat, defaultLng], {
                icon: pegmanIcon,
                draggable: true
            }).addTo(editMap);

            editMarker.on('dragend', function (e) {
                var pos = e.target.getLatLng();
                if (!isInsideSyria(pos.lat, pos.lng)) {
                    showEditMapError("⚠️ لا يمكن وضع العلامة خارج سوريا!");
                    e.target.setLatLng([defaultLat, defaultLng]);
                    return;
                }
                updateEditCoords(pos.lat, pos.lng);
            });

            editMap.on('click', function (e) {
                var pos = e.latlng;
                if (!isInsideSyria(pos.lat, pos.lng)) {
                    showEditMapError("⚠️ لا يمكن تحديد موقع خارج سوريا!");
                    return;
                }
                if (editMarker) {
                    editMap.removeLayer(editMarker);
                }
                editMarker = L.marker([pos.lat, pos.lng], {
                    icon: pegmanIcon,
                    draggable: true
                }).addTo(editMap);
                updateEditCoords(pos.lat, pos.lng);
                editMarker.on('dragend', function (ev) {
                    var newPos = ev.target.getLatLng();
                    if (!isInsideSyria(newPos.lat, newPos.lng)) {
                        showEditMapError("⚠️ لا يمكن وضع العلامة خارج سوريا!");
                        ev.target.setLatLng([pos.lat, pos.lng]);
                        return;
                    }
                    updateEditCoords(newPos.lat, newPos.lng);
                });
            });

            setTimeout(function () {
                editMap.invalidateSize();
            }, 500);
        }

        function showEditMapError(msg) {
            var errorDiv = document.createElement('div');
            errorDiv.style.cssText = 'position:absolute; top:10px; left:50%; transform:translateX(-50%); background:#dc3545; color:#fff; padding:10px 25px; border-radius:8px; z-index:999; font-weight:700; font-size:0.9rem; font-family:"Tajawal",sans-serif; direction:rtl; box-shadow:0 4px 20px rgba(0,0,0,0.3);';
            errorDiv.textContent = msg;
            var wrapper = document.getElementById('editMapWrapper');
            wrapper.appendChild(errorDiv);
            setTimeout(function () { errorDiv.remove(); }, 3000);
        }

        // ====== تحديث الإحداثيات ======
        function updateEditCoords(lat, lng) {
            document.getElementById('editLatDisplay').value = lat.toFixed(6);
            document.getElementById('editLngDisplay').value = lng.toFixed(6);
            document.getElementById('editLat').value = lat;
            document.getElementById('editLng').value = lng;
        }

        // ====== إعادة تعيين الموقع ======
        function resetEditLocation() {
            if (editMarker && editMap) {
                editMap.removeLayer(editMarker);
            }
            var pegmanSVG = `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 23 38" width="44" height="44">
                        <path d="M16.6 38.1h-5.5l-.2-2.9-.2 2.9H5.2L5 25.3l-.8 2a1.53 1.53 0 01-1.9.9l-1.2-.4a1.58 1.58 0 01-1-1.9v-.1c.3-.9 3.1-11.2 3.1-11.2a2.66 2.66 0 012.3-2l.6-.5a6.93 6.93 0 014.7-12 6.8 6.8 0 014.9 2 7 7 0 012 4.9 6.65 6.65 0 01-2.2 5l.7.5a2.78 2.78 0 012.4 2s2.9 11.2 2.9 11.3a1.53 1.53 0 01-.9 1.9l-1.3.4a1.63 1.63 0 01-1.9-.9l-.7-1.8z" fill="#333" opacity=".7"/>
                        <path d="m5.9 13.6 1.1-.9h7.8l1.2.9" fill="#ce592c"/>
                        <ellipse cx="10.9" cy="13.1" rx="2.7" ry=".3" fill="#ce592c" opacity=".5"/>
                        <path d="m20.6 26.1-2.9-11.3a1.71 1.71 0 00-1.6-1.2H5.7a1.69 1.69 0 00-1.5 1.3L1.1 26.2a.61.61 0 00.3.7l1.1.4a.61.61 0 00.7-.3l2.7-6.7.2 16.8h3.6l.6-9.3a.47.47 0 01.44-.5h.06c.4 0 .4.2.5.5l.6 9.3h3.6l.2-16.8 2.5 6.6a.52.52 0 00.66.31l1.2-.4a.57.57 0 00.5-.7Z" fill="#fdbf2d"/>
                        <circle cx="10.9" cy="7" r="5.9" fill="#fdbf2d"/>
                    </svg>`;

            var pegmanIcon = L.divIcon({
                className: 'pegman-marker',
                html: pegmanSVG,
                iconSize: [44, 44],
                iconAnchor: [22, 42]
            });

            var center = editMap.getCenter();
            editMarker = L.marker([center.lat, center.lng], {
                icon: pegmanIcon,
                draggable: true
            }).addTo(editMap);
            updateEditCoords(center.lat, center.lng);
            editMarker.on('dragend', function (e) {
                var pos = e.target.getLatLng();
                if (!isInsideSyria(pos.lat, pos.lng)) {
                    showEditMapError("⚠️ لا يمكن وضع العلامة خارج سوريا!");
                    e.target.setLatLng([center.lat, center.lng]);
                    return;
                }
                updateEditCoords(pos.lat, pos.lng);
            });
        }

        // ====== تشغيل الخريطة عند تحميل الصفحة ======
        document.addEventListener('DOMContentLoaded', function () {
            setTimeout(initEditMap, 500);
        });

        // ====== التحقق من صحة النموذج ======
        document.getElementById('editForm').addEventListener('submit', function (e) {
            var required = this.querySelectorAll('[required]');
            var isValid = true;
            var firstError = null;

            required.forEach(function (field) {
                var errorDiv = field.parentElement.querySelector('.error-message');
                var hint = field.parentElement.querySelector('.field-hint');

                // التحقق الخاص بالسعر
                if (field.id === 'Price' || field.name === 'Price') {
                    var val = parseFloat(field.value);
                    if (isNaN(val) || val <= 0) {
                        field.classList.add('error');
                        if (errorDiv) {
                            errorDiv.textContent = '⚠️ السعر يجب أن يكون أكبر من 0';
                            errorDiv.style.display = 'block';
                        }
                        if (hint) hint.style.color = '#dc3545';
                        isValid = false;
                        if (!firstError) firstError = field;
                        return;
                    } else {
                        field.classList.remove('error');
                        if (errorDiv) errorDiv.style.display = 'none';
                        if (hint) hint.style.color = 'var(--gray)';
                    }
                }

                // التحقق الخاص بالمساحة
                else if (field.id === 'Area' || field.name === 'Area') {
                    var val = parseFloat(field.value);
                    if (isNaN(val) || val <= 0) {
                        field.classList.add('error');
                        if (errorDiv) {
                            errorDiv.textContent = '⚠️ المساحة يجب أن تكون أكبر من 0';
                            errorDiv.style.display = 'block';
                        }
                        if (hint) hint.style.color = '#dc3545';
                        isValid = false;
                        if (!firstError) firstError = field;
                        return;
                    } else {
                        field.classList.remove('error');
                        if (errorDiv) errorDiv.style.display = 'none';
                        if (hint) hint.style.color = 'var(--gray)';
                    }
                }

                // التحقق الخاص برقم المحضر
                else if (field.id === 'PropertyNumber' || field.name === 'PropertyNumber') {
                    var val = parseInt(field.value);
                    if (isNaN(val) || val <= 0) {
                        field.classList.add('error');
                        if (errorDiv) {
                            errorDiv.textContent = '⚠️ رقم المحضر يجب أن يكون أكبر من 0';
                            errorDiv.style.display = 'block';
                        }
                        if (hint) hint.style.color = '#dc3545';
                        isValid = false;
                        if (!firstError) firstError = field;
                        return;
                    } else {
                        field.classList.remove('error');
                        if (errorDiv) errorDiv.style.display = 'none';
                        if (hint) hint.style.color = 'var(--gray)';
                    }
                }

                // التحقق العام
                else {
                    if (!field.value || field.value === '') {
                        field.classList.add('error');
                        if (errorDiv) {
                            errorDiv.textContent = '⚠️ هذا الحقل مطلوب';
                            errorDiv.style.display = 'block';
                        }
                        if (hint) hint.style.color = '#dc3545';
                        isValid = false;
                        if (!firstError) firstError = field;
                    } else {
                        field.classList.remove('error');
                        if (errorDiv) errorDiv.style.display = 'none';
                        if (hint) hint.style.color = 'var(--gray)';
                    }
                }
            });

            if (!isValid) {
                e.preventDefault();
                var errorPopup = document.createElement('div');
                errorPopup.className = 'error-popup';
                errorPopup.innerHTML = '<i class="fa-solid fa-circle-exclamation"></i> ⚠️ الرجاء تعبئة جميع الحقول المطلوبة بشكل صحيح';
                document.body.appendChild(errorPopup);
                setTimeout(function () {
                    errorPopup.style.opacity = '0';
                    setTimeout(function () { errorPopup.remove(); }, 500);
                }, 3000);

                if (firstError) {
                    firstError.focus();
                    firstError.scrollIntoView({ behavior: 'smooth', block: 'center' });
                }
            }
        });

        // ====== تفعيل وإلغاء تفعيل المرافق ======
        document.querySelectorAll('.amenity-item input[type="checkbox"]').forEach(function (cb) {
            cb.addEventListener('change', function () {
                this.parentElement.classList.toggle('checked');
            });
        });
    </script>

</body>
</html>