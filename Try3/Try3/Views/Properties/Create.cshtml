        function isValidPositiveNumber(value, allowZero = false) {
            if (value === null || value === undefined || value === '') return false;
            var num = Number(value);
            if (isNaN(num)) return false;
            return allowZero ? num >= 0 : num > 0;
        }

        function isValidPhone(phone) {
            if (!phone) return false;
            return /^09\d{8}$/.test(phone.trim());
        }

        function isValidPrice(price) {
            if (!isValidPositiveNumber(price)) return false;
            var num = Number(price);
            return num <= 9999999999999999.99;
        }

        function setFieldError(field, errorDiv, fieldHint, message) {
            field.classList.add("error");
            if (errorDiv) {
                errorDiv.textContent = message;
                errorDiv.style.display = "block";
            }
            if (fieldHint) fieldHint.style.color = "#dc3545";
        }

        // ====== دوال الخريطة (من الكود القديم مع الرجل الأصفر) ======
        function isInsideSyria(lat, lng) {
            let inside = false;
            for (let i = 0, j = syriaPolygon.length - 1; i < syriaPolygon.length; j = i++) {
                const xi = syriaPolygon[i][1];
                const yi = syriaPolygon[i][0];
                const xj = syriaPolygon[j][1];
                const yj = syriaPolygon[j][0];
                const intersect = ((yi > lat) !== (yj > lat)) && (lng < (xj - xi) * (lat - yi) / (yj - yi) + xi);
                if (intersect) inside = !inside;
            }
            return inside;
        }

        function populateNeighborhoods(cityId) {
            var select = document.getElementById('neighborhoodSelect');
            select.innerHTML = '<option value="" disabled selected hidden>اختر الحي</option>';
            var city = cityData[cityId];
            if (!city || !city.neighborhoods || city.neighborhoods.length === 0) {
                var opt = document.createElement('option');
                opt.value = '';
                opt.textContent = 'لا توجد أحياء مسجلة';
                select.appendChild(opt);
                select.disabled = true;
                return;
            }
            city.neighborhoods.forEach(function (n) {
                var opt = document.createElement('option');
                opt.value = n.name;
                opt.textContent = n.name;
                opt.dataset.lat = n.lat;
                opt.dataset.lng = n.lng;
                select.appendChild(opt);
            });
            select.disabled = false;
        }

        function onNeighborhoodChange(neighborhoodName) {
            if (!neighborhoodName) return;
            var cityId = document.getElementById('citySelect').value;
            var city = cityData[cityId];
            if (!city) return;
            var neighborhood = city.neighborhoods.find(n => n.name == neighborhoodName);
            if (neighborhood && map) {
                if (!isInsideSyria(neighborhood.lat, neighborhood.lng)) {
                    showMapError("⚠️ الموقع خارج حدود سوريا!");
                    return;
                }
                map.setView([neighborhood.lat, neighborhood.lng], 16);
                addMarker(neighborhood.lat, neighborhood.lng);
                document.getElementById("latDisplay").innerHTML = neighborhood.lat.toFixed(6);
                document.getElementById("lngDisplay").innerHTML = neighborhood.lng.toFixed(6);
                document.getElementById("inputLat").value = neighborhood.lat;
                document.getElementById("inputLng").value = neighborhood.lng;
                showMapSuccess();
            }
        }

        function onCityChange(cityId) {
            var city = cityData[cityId];
            if (!city) return;
            if (map) {
                map.setView([city.lat, city.lng], city.zoom || 13);
                addMarker(city.lat, city.lng);
            }
            document.getElementById("latDisplay").innerHTML = city.lat.toFixed(6);
            document.getElementById("lngDisplay").innerHTML = city.lng.toFixed(6);
            document.getElementById("inputLat").value = city.lat;
            document.getElementById("inputLng").value = city.lng;
            populateNeighborhoods(cityId);
            document.getElementById('neighborhoodSelect').value = '';
        }

        function initMap(cityId) {
            if (map) { map.remove(); map = null; }
            var city = cityData[cityId] || cityData[defaultCityId];
            var mapElement = document.getElementById("map");
            if (!mapElement) return;
            map = L.map("map", { zoomControl: false, dragging: true, minZoom: 8, maxZoom: 19 })
                .setView([city.lat, city.lng], city.zoom || 13);
            L.control.zoom({ position: "topright" }).addTo(map);
            var baseLayer = L.tileLayer("https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png", { maxZoom: 19, attribution: '© OpenStreetMap' }).addTo(map);
            var satelliteLayer = L.tileLayer("https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}", { maxZoom: 19 });
            var satelliteLabels = L.tileLayer("https://server.arcgisonline.com/ArcGIS/rest/services/Reference/World_Boundaries_and_Places/MapServer/tile/{z}/{y}/{x}", { maxZoom: 19 });
            map._baseLayer = baseLayer;
            map._satelliteLayer = satelliteLayer;
            map._satelliteLabels = satelliteLabels;
            map._currentLayer = 'map';
            addMarker(city.lat, city.lng);
            document.getElementById("latDisplay").innerHTML = city.lat.toFixed(6);
            document.getElementById("lngDisplay").innerHTML = city.lng.toFixed(6);
            document.getElementById("inputLat").value = city.lat;
            document.getElementById("inputLng").value = city.lng;
            populateNeighborhoods(cityId);
            setTimeout(function () { map.invalidateSize(); }, 500);
        }

        function addMarker(lat, lng) {
            if (!isInsideSyria(lat, lng)) {
                showMapError("⚠️ لا يمكن تحديد موقع خارج الأراضي السورية!");
                return;
            }
            if (currentMarker) { map.removeLayer(currentMarker); currentMarker = null; }

            // ✅ الرجل الأصفر من الكود القديم
            var pegmanIcon = L.divIcon({
                className: 'pegman-marker',
                html: '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 23 38" width="44" height="44"><path d="M16.6 38.1h-5.5l-.2-2.9-.2 2.9H5.2L5 25.3l-.8 2a1.53 1.53 0 01-1.9.9l-1.2-.4a1.58 1.58 0 01-1-1.9v-.1c.3-.9 3.1-11.2 3.1-11.2a2.66 2.66 0 012.3-2l.6-.5a6.93 6.93 0 014.7-12 6.8 6.8 0 014.9 2 7 7 0 012 4.9 6.65 6.65 0 01-2.2 5l.7.5a2.78 2.78 0 012.4 2s2.9 11.2 2.9 11.3a1.53 1.53 0 01-.9 1.9l-1.3.4a1.63 1.63 0 01-1.9-.9l-.7-1.8z" fill="#333" opacity=".7"/><path d="m5.9 13.6 1.1-.9h7.8l1.2.9" fill="#ce592c"/><ellipse cx="10.9" cy="13.1" rx="2.7" ry=".3" fill="#ce592c" opacity=".5"/><path d="m20.6 26.1-2.9-11.3a1.71 1.71 0 00-1.6-1.2H5.7a1.69 1.69 0 00-1.5 1.3L1.1 26.2a.61.61 0 00.3.7l1.1.4a.61.61 0 00.7-.3l2.7-6.7.2 16.8h3.6l.6-9.3a.47.47 0 01.44-.5h.06c.4 0 .4.2.5.5l.6 9.3h3.6l.2-16.8 2.5 6.6a.52.52 0 00.66.31l1.2-.4a.57.57 0 00.5-.7Z" fill="#fdbf2d"/><path d="m7 13.6 3.9 6.7 3.9-6.7" fill="#cf572e" opacity=".6"/><circle cx="10.9" cy="7" r="5.9" fill="#fdbf2d"/></svg>',
                iconSize: [44, 44],
                iconAnchor: [22, 42]
            });

            currentMarker = L.marker([lat, lng], { icon: pegmanIcon, draggable: true }).addTo(map);
            currentMarker.on('dragend', function (e) {
                var pos = e.target.getLatLng();
                if (!isInsideSyria(pos.lat, pos.lng)) {
                    showMapError("⚠️ لا يمكن وضع العلامة خارج سوريا!");
                    e.target.setLatLng([lat, lng]);
                    return;
                }
                document.getElementById("latDisplay").innerHTML = pos.lat.toFixed(6);
                document.getElementById("lngDisplay").innerHTML = pos.lng.toFixed(6);
                document.getElementById("inputLat").value = pos.lat;
                document.getElementById("inputLng").value = pos.lng;
                showMapSuccess();
            });
            map.on('click', function (e) {
                var pos = e.latlng;
                if (!isInsideSyria(pos.lat, pos.lng)) {
                    showMapError("⚠️ لا يمكن تحديد موقع خارج سوريا!");
                    return;
                }
                addMarker(pos.lat, pos.lng);
                document.getElementById("latDisplay").innerHTML = pos.lat.toFixed(6);
                document.getElementById("lngDisplay").innerHTML = pos.lng.toFixed(6);
                document.getElementById("inputLat").value = pos.lat;
                document.getElementById("inputLng").value = pos.lng;
                showMapSuccess();
            });
        }

        function showMapError(msg) {
            var mapErr = document.getElementById("mapError");
            if (mapErr) {
                mapErr.textContent = msg;
                mapErr.style.display = "block";
                mapErr.style.color = "#dc3545";
                setTimeout(function () { mapErr.style.display = "none"; }, 3000);
            }
        }

        function showMapSuccess() {
            var mapErr = document.getElementById("mapError");
            if (mapErr) {
                mapErr.textContent = "✅ تم تحديد الموقع بنجاح!";
                mapErr.style.display = "block";
                mapErr.style.color = "#22c55e";
                setTimeout(function () { mapErr.style.display = "none"; }, 3000);
            }
        }

        function resetLocation() {
            document.getElementById("latDisplay").innerHTML = "--";
            document.getElementById("lngDisplay").innerHTML = "--";
            document.getElementById("inputLat").value = "";
            document.getElementById("inputLng").value = "";
            if (currentMarker) { map.removeLayer(currentMarker); currentMarker = null; }
            var mapErr = document.getElementById("mapError");
            if (mapErr) {
                mapErr.textContent = "⚠️ لم تحدد الموقع على الخريطة";
                mapErr.style.display = "block";
                mapErr.style.color = "#f59e0b";
                setTimeout(function () { mapErr.style.display = "none"; }, 3000);
            }
            var cityId = document.getElementById('citySelect').value || defaultCityId;
            var city = cityData[cityId];
            if (city && map) {
                addMarker(city.lat, city.lng);
                document.getElementById("latDisplay").innerHTML = city.lat.toFixed(6);
                document.getElementById("lngDisplay").innerHTML = city.lng.toFixed(6);
                document.getElementById("inputLat").value = city.lat;
                document.getElementById("inputLng").value = city.lng;
            }
        }

        function setLayer(type) {
            if (!map) return;
            var btnMap = document.getElementById("btnMap");
            var btnSat = document.getElementById("btnSat");
            if (type === "satellite") {
                if (map.hasLayer(map._baseLayer)) map.removeLayer(map._baseLayer);
                map._satelliteLayer.addTo(map);
                map._satelliteLabels.addTo(map);
                btnSat.classList.add("active");
                btnMap.classList.remove("active");
            } else {
                if (map.hasLayer(map._satelliteLayer)) map.removeLayer(map._satelliteLayer);
                if (map.hasLayer(map._satelliteLabels)) map.removeLayer(map._satelliteLabels);
                map._baseLayer.addTo(map);
                btnMap.classList.add("active");
                btnSat.classList.remove("active");
            }
        }

        function toggleFullscreen() {
            var w = document.getElementById("mapWrapper");
            if (!document.fullscreenElement) { w.requestFullscreen(); }
            else { document.exitFullscreen(); }
        }

        // ====== دوال التنقل بين الخطوات ======
        function changeStep(dir) {
            var next = currentStep + dir;
            if (next < 1 || next > 5) return;
            // ✅ التحقق من جميع الخطوات (بما فيها الخطوة 3)
            if (dir > 0) {
                if (!validateCurrentStep()) { return; }
            }
            document.querySelector('.form-step[data-step="' + currentStep + '"]').classList.add("hidden");
            document.querySelector('.form-step[data-step="' + next + '"]').classList.remove("hidden");
            updateTimeline(next);
            currentStep = next;
            if (currentStep === 3) {
                setTimeout(function () {
                    if (!map) {
                        var cityId = document.getElementById('citySelect').value || defaultCityId;
                        initMap(cityId);
                    } else {
                        setTimeout(function () { map.invalidateSize(); }, 100);
                    }
                }, 150);
            }
            window.scrollTo({ top: 0, behavior: "smooth" });
        }

        function updateTimeline(step) {
            document.querySelectorAll(".timeline .step").forEach(function (el) {
                var s = parseInt(el.dataset.step);
                el.classList.remove("active", "completed");
                if (s < step) el.classList.add("completed");
                else if (s === step) el.classList.add("active");
            });
            var prev = document.getElementById("prevBtn");
            var next = document.getElementById("nextBtn");
            var pub = document.getElementById("pubBtn");
            if (prev) prev.style.display = step === 1 ? "none" : "flex";
            if (next) next.style.display = step === 5 ? "none" : "flex";
            if (pub) pub.style.display = step === 5 ? "flex" : "none";
            syncLine();
        }

        function syncLine() {
            var tl = document.getElementById("timeline");
            var circles = document.querySelectorAll(".timeline .circle");
            if (!circles.length || !tl) return;
            var bgLine = document.getElementById("bgLine");
            var progress = document.getElementById("progress");
            var tR = tl.getBoundingClientRect();
            var fR = circles[0].getBoundingClientRect();
            var lR = circles[circles.length - 1].getBoundingClientRect();
            var active = document.querySelector(".timeline .step.active .circle") || circles[0];
            var aR = active.getBoundingClientRect();
            var tF = fR.top + fR.height / 2 - tR.top;
            var tL = lR.top + lR.height / 2 - tR.top;
            var tA = aR.top + aR.height / 2 - tR.top;
            var rP = tR.width - (fR.left + fR.width / 2 - tR.left) - 1;
            if (bgLine) { bgLine.style.top = tF + "px"; bgLine.style.right = rP + "px"; bgLine.style.height = Math.max(0, tL - tF) + "px"; }
            if (progress) { progress.style.top = tF + "px"; progress.style.right = rP + "px"; progress.style.height = Math.max(0, tA - tF) + "px"; }
        }

        // ====== دالة validateCurrentStep المحسّنة ======
        function validateCurrentStep() {
            var step = currentStep;
            var stepDiv = document.querySelector('.form-step[data-step="' + step + '"]');
            var required = stepDiv.querySelectorAll("[required]");
            var isValid = true;
            var firstError = null;

            required.forEach(function (field) {
                if (field.id === "inputLat" || field.id === "inputLng") return;
                var errorDiv = field.parentElement.querySelector(".error-message");
                var fieldHint = field.parentElement.querySelector(".field-hint");
                var value = field.value.trim();
                field.classList.remove("error");
                if (errorDiv) { errorDiv.style.display = "none"; errorDiv.textContent = ""; }
                if (fieldHint) { fieldHint.style.color = "var(--gray)"; }

                // التحقق من الحقول الرقمية
                if (field.id === "Price" || field.name === "Price") {
                    if (!isValidPrice(value)) {
                        setFieldError(field, errorDiv, fieldHint, "⚠️ السعر يجب أن يكون رقماً موجباً (أكبر من 0)");
                        isValid = false;
                        if (!firstError) firstError = field;
                    }
                } else if (field.id === "Area" || field.name === "Area") {
                    if (!isValidPositiveNumber(value)) {
                        setFieldError(field, errorDiv, fieldHint, "⚠️ المساحة يجب أن تكون رقماً موجباً (أكبر من 0)");
                        isValid = false;
                        if (!firstError) firstError = field;
                    }
                } else if (field.id === "PropertyNumber" || field.name === "PropertyNumber") {
                    if (!isValidPositiveNumber(value)) {
                        setFieldError(field, errorDiv, fieldHint, "⚠️ رقم المحضر يجب أن يكون رقماً موجباً (أكبر من 0)");
                        isValid = false;
                        if (!firstError) firstError = field;
                    }
                } else if (field.id === "Rooms" || field.name === "Rooms") {
                    if (!isValidPositiveNumber(value, true)) {
                        setFieldError(field, errorDiv, fieldHint, "⚠️ عدد الغرف يجب أن يكون رقماً غير سالب (0 أو أكثر)");
                        isValid = false;
                        if (!firstError) firstError = field;
                    }
                } else if (field.id === "Bathrooms" || field.name === "Bathrooms") {
                    if (!isValidPositiveNumber(value, true)) {
                        setFieldError(field, errorDiv, fieldHint, "⚠️ عدد الحمامات يجب أن يكون رقماً غير سالب (0 أو أكثر)");
                        isValid = false;
                        if (!firstError) firstError = field;
                    }
                } else if (field.id === "Floor" || field.name === "Floor") {
                    if (value !== '') {
                        var num = Number(value);
                        if (isNaN(num) || num < -2) {
                            setFieldError(field, errorDiv, fieldHint, "⚠️ رقم الطابق يجب أن يكون رقماً (أقل قيمة -2)");
                            isValid = false;
                            if (!firstError) firstError = field;
                        }
                    }
                } else if (field.id === "AdvertiserPhone" || field.name === "AdvertiserPhone") {
                    if (!isValidPhone(value)) {
                        setFieldError(field, errorDiv, fieldHint, "⚠️ رقم الهاتف يجب أن يكون 10 أرقام ويبدأ بـ 09 (مثال: 0912345678)");
                        isValid = false;
                        if (!firstError) firstError = field;
                    }
                } else if (field.id === "Neighborhood" || field.name === "Neighborhood") {
                    // ✅ تحقق خاص للحي: يجب ألا يكون الخيار الفارغ
                    if (!value || value === "") {
                        setFieldError(field, errorDiv, fieldHint, "⚠️ الرجاء اختيار الحي");
                        isValid = false;
                        if (!firstError) firstError = field;
                    }
                } else {
                    // تحقق عام للحقول الأخرى (مع استثناء الحقول الاختيارية)
                    var isOptional = (field.id === "Description" || field.id === "Address" || field.id === "DetailedLocation");
                    if (!isOptional && (!value || value === "")) {
                        setFieldError(field, errorDiv, fieldHint, "⚠️ هذا الحقل مطلوب");
                        isValid = false;
                        if (!firstError) firstError = field;
                    }
                }
            });

            // تحقق خاص للصورة الأساسية
            if (step === 2) {
                var mainImg = document.getElementById("mainImg");
                var err = document.getElementById("mainImgError");
                var hint = document.querySelector('.form-step[data-step="2"] .field-hint');
                if (!mainImg.files || mainImg.files.length === 0) {
                    if (err) { err.textContent = "⚠️ الصورة الأساسية مطلوبة"; err.style.display = "block"; }
                    if (hint) hint.style.color = "#dc3545";
                    isValid = false;
                } else {
                    if (err) err.style.display = "none";
                    if (hint) hint.style.color = "var(--gray)";
                }
            }

            // تحقق للخريطة (تنبيه فقط، لا يمنع الانتقال)
            if (step === 3) {
                var lat = document.getElementById("inputLat").value;
                var lng = document.getElementById("inputLng").value;
                var mapErr = document.getElementById("mapError");
                if (!lat || !lng) {
                    if (mapErr) {
                        mapErr.textContent = "⚠️ يرجى تحديد موقع العقار على الخريطة";
                        mapErr.style.display = "block";
                        mapErr.style.color = "#f59e0b";
                    }
                } else {
                    if (mapErr) mapErr.style.display = "none";
                }
            }

            if (!isValid && firstError) {
                firstError.focus();
                firstError.scrollIntoView({ behavior: 'smooth', block: 'center' });
            }
            return isValid;
        }

        // ====== دوال رفع الصور ======
        function handleMainImg(input) {
            if (input.files && input.files[0]) {
                var reader = new FileReader();
                reader.onload = function (e) {
                    document.getElementById("mainImgPrev").innerHTML = '<div class="uploaded-img"><img src="' + e.target.result + '"><button type="button" class="remove-btn" onclick="removeMainImg()"><i class="fa-solid fa-xmark"></i></button></div>';
                    var err = document.getElementById("mainImgError");
                    if (err) err.style.display = "none";
                    var hint = document.querySelector('.form-step[data-step="2"] .field-hint');
                    if (hint) hint.style.color = "var(--gray)";
                };
                reader.readAsDataURL(input.files[0]);
            }
        }

        function removeMainImg() {
            document.getElementById("mainImgPrev").innerHTML = "";
            document.getElementById("mainImg").value = "";
            var err = document.getElementById("mainImgError");
            if (err) {
                err.textContent = "⚠️ الصورة الأساسية مطلوبة";
                err.style.display = "block";
            }
        }

        function handlePropImgs(input) {
            if (input.files) {
                var prev = document.getElementById("propImgsPrev");
                Array.from(input.files).forEach(function (file) {
                    var reader = new FileReader();
                    reader.onload = function (e) {
                        prev.innerHTML += '<div class="uploaded-img"><img src="' + e.target.result + '"><button type="button" class="remove-btn" onclick="this.closest(\'.uploaded-img\').remove()"><i class="fa-solid fa-xmark"></i></button></div>';
                    };
                    reader.readAsDataURL(file);
                });
            }
        }

        function forceNext() {
            var next = currentStep + 1;
            if (next > 5) return;
            document.querySelector('.form-step[data-step="' + currentStep + '"]').classList.add("hidden");
            document.querySelector('.form-step[data-step="' + next + '"]').classList.remove("hidden");
            updateTimeline(next);
            currentStep = next;
            if (currentStep === 3) {
                setTimeout(function () {
                    if (!map) {
                        var cityId = document.getElementById('citySelect').value || defaultCityId;
                        initMap(cityId);
                    } else {
                        map.invalidateSize();
                    }
                }, 150);
            }
            window.scrollTo({ top: 0, behavior: "smooth" });
        }

        // ====== حدث submit للتحقق النهائي ======
        document.getElementById('propForm').addEventListener('submit', function (e) {
            if (currentStep !== 5) {
                e.preventDefault();
                showCustomNotification('⚠️ يرجى إكمال جميع الخطوات أولاً', 'warning');
                return;
            }

            var allFields = this.querySelectorAll('[required]');
            var allValid = true;
            var firstError = null;

            allFields.forEach(function (field) {
                if (field.id === "inputLat" || field.id === "inputLng") return;
                var errorDiv = field.parentElement.querySelector(".error-message");
                var fieldHint = field.parentElement.querySelector(".field-hint");
                var value = field.value.trim();
                field.classList.remove("error");
                if (errorDiv) { errorDiv.style.display = "none"; errorDiv.textContent = ""; }
                if (fieldHint) { fieldHint.style.color = "var(--gray)"; }

                if (field.id === "Price" || field.name === "Price") {
                    if (!isValidPrice(value)) {
                        setFieldError(field, errorDiv, fieldHint, "⚠️ السعر يجب أن يكون رقماً موجباً");
                        allValid = false;
                        if (!firstError) firstError = field;
                    }
                } else if (field.id === "Area" || field.name === "Area") {
                    if (!isValidPositiveNumber(value)) {
                        setFieldError(field, errorDiv, fieldHint, "⚠️ المساحة يجب أن تكون رقماً موجباً");
                        allValid = false;
                        if (!firstError) firstError = field;
                    }
                } else if (field.id === "PropertyNumber" || field.name === "PropertyNumber") {
                    if (!isValidPositiveNumber(value)) {
                        setFieldError(field, errorDiv, fieldHint, "⚠️ رقم المحضر يجب أن يكون رقماً موجباً");
                        allValid = false;
                        if (!firstError) firstError = field;
                    }
                } else if (field.id === "Rooms" || field.name === "Rooms") {
                    if (!isValidPositiveNumber(value, true)) {
                        setFieldError(field, errorDiv, fieldHint, "⚠️ عدد الغرف يجب أن يكون غير سالب");
                        allValid = false;
                        if (!firstError) firstError = field;
                    }
                } else if (field.id === "Bathrooms" || field.name === "Bathrooms") {
                    if (!isValidPositiveNumber(value, true)) {
                        setFieldError(field, errorDiv, fieldHint, "⚠️ عدد الحمامات يجب أن يكون غير سالب");
                        allValid = false;
                        if (!firstError) firstError = field;
                    }
                } else if (field.id === "Floor" || field.name === "Floor") {
                    if (value !== '') {
                        var num = Number(value);
                        if (isNaN(num) || num < -2) {
                            setFieldError(field, errorDiv, fieldHint, "⚠️ رقم الطابق يجب أن يكون رقماً (أقل قيمة -2)");
                            allValid = false;
                            if (!firstError) firstError = field;
                        }
                    }
                } else if (field.id === "AdvertiserPhone" || field.name === "AdvertiserPhone") {
                    if (!isValidPhone(value)) {
                        setFieldError(field, errorDiv, fieldHint, "⚠️ رقم الهاتف يجب أن يكون 10 أرقام ويبدأ بـ 09");
                        allValid = false;
                        if (!firstError) firstError = field;
                    }
                } else if (field.id === "Neighborhood" || field.name === "Neighborhood") {
                    if (!value || value === "") {
                        setFieldError(field, errorDiv, fieldHint, "⚠️ الرجاء اختيار الحي");
                        allValid = false;
                        if (!firstError) firstError = field;
                    }
                } else {
                    var isOptional = (field.id === "Description" || field.id === "Address" || field.id === "DetailedLocation");
                    if (!isOptional && (!value || value === "")) {
                        setFieldError(field, errorDiv, fieldHint, "⚠️ هذا الحقل مطلوب");
                        allValid = false;
                        if (!firstError) firstError = field;
                    }
                }
            });

            var mainImg = document.getElementById("mainImg");
            if (!mainImg.files || mainImg.files.length === 0) {
                allValid = false;
                showCustomNotification('⚠️ يجب رفع صورة أساسية للعقار', 'error');
            }

            var lat = document.getElementById("inputLat").value;
            var lng = document.getElementById("inputLng").value;
            if (!lat || !lng) {
                allValid = false;
                showCustomNotification('⚠️ يرجى تحديد موقع العقار على الخريطة', 'error');
            }

            if (!allValid) {
                e.preventDefault();
                if (firstError) {
                    firstError.focus();
                    firstError.scrollIntoView({ behavior: 'smooth', block: 'center' });
                }
            }
        });

        // ====== دالة عرض الإشعارات ======
        function showCustomNotification(message, type) {
            var existing = document.querySelector('.custom-notification');
            if (existing) existing.remove();
            var notif = document.createElement('div');
            notif.className = 'custom-notification ' + type;
            notif.textContent = message;
            notif.style.cssText = 'position:fixed; top:20px; left:50%; transform:translateX(-50%); padding:15px 30px; border-radius:12px; font-weight:700; font-size:1.1rem; z-index:99999; box-shadow:0 10px 40px rgba(0,0,0,0.3); font-family:"Tajawal",sans-serif;';
            if (type === 'success') { notif.style.background = '#22c55e'; notif.style.color = '#fff'; }
            else if (type === 'error') { notif.style.background = '#dc3545'; notif.style.color = '#fff'; }
            else if (type === 'warning') { notif.style.background = '#f59e0b'; notif.style.color = '#fff'; }
            else { notif.style.background = '#192e43'; notif.style.color = '#d4af37'; }
            document.body.appendChild(notif);
            setTimeout(function () {
                notif.style.opacity = '0';
                setTimeout(function () { notif.remove(); }, 500);
            }, 4000);
        }

        // ====== تهيئة الصفحة ======
        document.addEventListener('DOMContentLoaded', function () {
            var today = new Date().toISOString().split('T')[0];
            var availableFrom = document.getElementById('available_from');
            if (availableFrom) { availableFrom.setAttribute('min', today); }

            var citySelect = document.getElementById('citySelect');
            citySelect.value = defaultCityId;
            initMap(defaultCityId);
            updateTimeline(1);

            // ربط حدث تغيير المدينة
            citySelect.addEventListener('change', function () {
                onCityChange(this.value);
            });

            // ربط حدث تغيير الحي
            var neighborhoodSelect = document.getElementById('neighborhoodSelect');
            if (neighborhoodSelect) {
                neighborhoodSelect.addEventListener('change', function () {
                    onNeighborhoodChange(this.value);
                });
            }

            window.addEventListener('resize', function () {
                if (map) { setTimeout(function () { map.invalidateSize(); }, 300); }
            });
        });

        window.onscroll = function () {
            var btn = document.getElementById('scrollBtn');
            if (btn) { btn.classList.toggle('show', document.documentElement.scrollTop > 300); }
        };
    </script>

</body>
</html>