@model RealEstateWebApp.Models.PropertyViewModel
@using RealEstateWebApp.Models
@using Microsoft.AspNetCore.Identity
@inject SignInManager<ApplicationUser> SignInManager
@{
    ViewData["Title"] = "أعلن عن عقارك";
    Layout = null;
}
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] | SYRELIS - العقارات الفاخرة</title>

    <!-- ====== جميع CDN ====== -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Tajawal:wght@300;400;500;700;800;900&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />

    <style>
        /* ====== جميع التنسيقات كما هي (نفس الكود السابق) ====== */
        :root {
            --dark: #192e43;
            --gold: #d4af37;
            --gray: #51596a;
            --white: #ffffff;
            --gold-light: #f4e5c2;
            --gold-dark: #917005;
            --border: #e8e4dc;
            --bg-light: #f8f9fa;
            --shadow: 0 4px 16px rgba(11, 19, 32, 0.08);
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            background: linear-gradient(126deg, rgba(11, 19, 32, 0.85), rgb(11 19 32 / 62%)), url(https://images.unsplash.com/photo-1600585154526-990dced4db0d?q=80&w=2070&auto=format);
            background-position: center;
            background-attachment: fixed;
            font-family: "Tajawal", sans-serif;
            color: var(--gold);
            line-height: 1.6;
            min-height: 100vh;
        }

        .container {
            max-width: 1400px;
            margin: 0 auto;
            padding: 2rem;
        }

        .navbar {
            background: rgba(11, 19, 32, 0.96);
            padding: 0 1rem;
            display: flex;
            align-items: center;
            border-bottom: 1px solid rgba(212, 175, 55, 0.4);
            justify-content: space-between;
            box-shadow: 0px 15px 30px -10px rgb(23, 22, 70);
            position: sticky;
            top: 0;
            z-index: 2000;
            flex-wrap: wrap;
            gap: 10px;
        }

            .navbar .logo {
                width: 82px;
                margin: 8px 0;
                flex-shrink: 0;
            }

            .navbar .nav-links {
                display: flex;
                gap: 30px;
                list-style: none;
                flex-wrap: wrap;
                justify-content: center;
                padding: 0;
            }

                .navbar .nav-links a {
                    color: #f2efea;
                    text-decoration: none;
                    font-weight: 600;
                    font-size: 0.95rem;
                    transition: 0.3s;
                    white-space: nowrap;
                }

                    .navbar .nav-links a:hover {
                        color: #d4af37;
                    }

        .navbar-right {
            display: flex;
            align-items: center;
            gap: 15px;
            margin-right: 3cm;
        }

        .user-avatar {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 42px;
            height: 42px;
            border-radius: 50%;
            background: linear-gradient(135deg, #d4af37, #b8941f);
            color: #0b1320;
            font-weight: 800;
            font-size: 1.1rem;
            font-family: 'Tajawal', sans-serif;
            cursor: pointer;
            transition: all 0.3s ease;
            border: 2px solid rgba(212, 175, 55, 0.4);
            box-shadow: 0 2px 10px rgba(212, 175, 55, 0.2);
            text-decoration: none;
            user-select: none;
            position: relative;
        }

            .user-avatar:hover {
                transform: scale(1.08);
                box-shadow: 0 4px 20px rgba(212, 175, 55, 0.4);
                border-color: #d4af37;
            }

            .user-avatar .tooltip {
                position: absolute;
                top: 110%;
                left: 50%;
                transform: translateX(-50%);
                background: #0b1320;
                color: #d4af37;
                padding: 6px 14px;
                border-radius: 8px;
                font-size: 0.75rem;
                font-weight: 600;
                white-space: nowrap;
                opacity: 0;
                visibility: hidden;
                transition: all 0.3s ease;
                border: 1px solid rgba(212, 175, 55, 0.2);
                pointer-events: none;
                font-family: 'Tajawal', sans-serif;
            }

            .user-avatar:hover .tooltip {
                opacity: 1;
                visibility: visible;
                top: 120%;
            }

            .user-avatar .tooltip::before {
                content: '';
                position: absolute;
                bottom: 100%;
                left: 50%;
                transform: translateX(-50%);
                border: 6px solid transparent;
                border-bottom-color: #0b1320;
            }

        .page-header {
            padding: 30px 35px;
            margin-bottom: 49px;
            box-shadow: 0 8px 24px rgba(11, 19, 32, 0.15);
            display: flex;
            align-items: center;
            justify-content: space-between;
            flex-wrap: wrap;
            gap: 20px;
            width: 100%;
            border-bottom: 2px solid #e2bd46;
        }

        .back-button {
            width: 57px;
            height: 54px;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            padding: 12px 25px;
            background: linear-gradient(135deg, var(--gold) 0%, var(--gold-dark) 100%);
            border: 2px solid var(--white);
            border-radius: 12px;
            color: var(--dark);
            font-size: 16px;
            font-weight: 700;
            cursor: pointer;
            transition: all 0.3s ease;
            text-decoration: none;
            font-family: "Tajawal", sans-serif;
        }

        .page-info {
            display: flex;
            align-items: center;
            gap: 20px;
        }

        .page-title h1 {
            color: #e2bd46 !important;
            margin: 0;
            font-size: 2rem;
            font-weight: 800;
        }

        .page-title p {
            color: rgba(255, 255, 255, 0.8);
            font-size: 1rem;
            margin: 5px 0 0 0;
        }

        .card {
            max-width: 100%;
            background: var(--white);
            border-radius: 20px;
            padding: 28px;
            margin-top: 30px;
            margin-bottom: 61px;
        }

        .card-header {
            font-size: 1.25rem;
            font-weight: 800;
            color: var(--dark);
            margin-bottom: 22px;
            padding-bottom: 14px;
            border-bottom: 2px solid var(--bg-light);
            display: flex;
            align-items: center;
            gap: 10px;
        }

            .card-header .icon-circle {
                width: 40px;
                height: 40px;
                background: #192e43;
                border-radius: 16px;
                display: flex;
                align-items: center;
                justify-content: center;
                color: #ffd754;
                font-size: 1.2rem;
            }

        .form-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
            gap: 20px;
        }

        .form-group {
            display: flex;
            flex-direction: column;
            gap: 7px;
        }

            .form-group.full {
                grid-column: 1 / -1;
            }

            .form-group label {
                font-weight: 500;
                color: var(--dark);
                font-size: 1rem;
            }

                .form-group label .req {
                    font-weight: 800;
                    color: #b20011;
                    font-size: 1.3rem;
                }

            .form-group .field-hint {
                font-size: 0.8rem;
                color: var(--gray);
                margin-top: 2px;
                display: block;
            }

            .form-group .error-message {
                color: #dc3545;
                font-size: 0.85rem;
                margin-top: 4px;
                display: none;
            }

        .form-control.error {
            border-color: #dc3545 !important;
        }

        .form-control {
            padding: 12px 15px;
            border: 2px solid var(--border);
            border-radius: 10px;
            font-family: "Tajawal", sans-serif;
            font-size: 0.95rem;
            background: var(--white);
            color: var(--dark);
            transition: all 0.25s;
        }

            .form-control:focus {
                outline: none;
                border-color: #192e43;
                box-shadow: 0 0 0 2px rgb(215 219 232);
            }

        select.form-control {
            appearance: none;
            -webkit-appearance: none;
            background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='16' height='16' viewBox='0 0 24 24' fill='none' stroke='%23333' stroke-width='2'><polyline points='6 9 12 15 18 9'/></svg>");
            background-repeat: no-repeat;
            background-position: left 12px center;
            padding: 10px 12px 10px 35px;
            background-color: white;
            cursor: pointer;
        }

        .form-step {
            display: block !important;
        }

            .form-step.hidden {
                display: none !important;
            }

        .main-layout {
            margin-top: 30px;
            display: flex !important;
            flex-direction: row !important;
            gap: 28px !important;
        }

        .steps-sidebar {
            width: 320px !important;
            flex-shrink: 0 !important;
        }

        .steps-sticky {
            position: sticky;
            top: 110px;
        }

        .timeline {
            gap: 1.5rem;
            display: flex;
            height: 35.5rem;
            background: var(--white);
            border-radius: 20px;
            padding: 35px 30px;
            box-shadow: var(--shadow);
            border: 1px solid var(--border);
            flex-direction: column;
            position: relative;
        }

        .step {
            display: flex !important;
            align-items: center;
            gap: 18px;
            padding: 14px 0;
            cursor: pointer;
            position: relative;
            z-index: 2;
        }

        .circle {
            width: 44px;
            height: 44px;
            border-radius: 50%;
            background: var(--white);
            border: 2px solid var(--border);
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 700;
            font-size: 1rem;
            color: var(--gray);
            transition: all 0.3s ease;
            flex-shrink: 0;
            z-index: 2;
        }

        .info {
            flex: 1;
        }

        .info-title {
            font-size: 1rem;
            font-weight: 600;
            color: var(--dark);
        }

        .info-sub {
            font-size: 0.82rem;
            color: #999;
        }

        .step.active .circle {
            border-color: #4e5468;
            background: var(--dark);
            color: white;
            transform: scale(1.08);
            box-shadow: 0 0 0 5px rgb(17 44 121 / 17%);
        }

        .step.active .info-title {
            color: #022242;
            font-size: 19px;
            font-weight: 700;
        }

        .step.active .info-sub {
            color: #000000;
        }

        .step.completed .circle {
            box-shadow: 0 0 0 5px rgb(169 160 9 / 17%);
            border-color: #795e08;
            background: #d4af37;
            width: 52px;
            height: 52px;
            color: white;
        }

            .step.completed .circle::after {
                content: "✓";
                font-size: 1.5rem;
            }

            .step.completed .circle span {
                display: none;
            }

        .content-area {
            margin-top: -51px;
            flex: 1;
            min-width: 0;
        }

        .btn {
            padding: 12px 26px;
            border: none;
            border-radius: 10px;
            font-family: "Tajawal", sans-serif;
            font-size: 0.98rem;
            font-weight: 700;
            cursor: pointer;
            display: inline-flex;
            align-items: center;
            gap: 7px;
            text-decoration: none;
        }

        .btn-primary {
            background: var(--dark);
            color: #ffffff;
            box-shadow: -1px 2px 9px rgb(11 19 32 / 73%);
        }

            .btn-primary:hover {
                background: #ffffff;
                color: #1a3250;
            }

        .btn-secondary {
            border: 1px solid #1a3250;
            background: #1a314d;
            color: #ffffff;
            border-radius: 10px;
            padding: 10px 20px;
            font-size: 16px;
            font-weight: 600;
            cursor: pointer;
        }

            .btn-secondary:hover {
                background: #ffffff;
                color: #1a3250;
            }

        .form-actions {
            display: flex !important;
            justify-content: space-between;
            padding-top: 23px !important;
        }

        .btn-group {
            display: flex;
            gap: 11px;
        }

        .upload-box {
            border: 2px dashed var(--border);
            border-radius: 14px;
            padding: 32px 20px;
            text-align: center;
            background: var(--bg-light);
            cursor: pointer;
            transition: all 0.3s;
        }

            .upload-box:hover {
                border-color: #05155e;
                background: #e8e5cf69;
            }

            .upload-box i {
                font-size: 2.8rem;
                color: var(--gold);
                margin-bottom: 10px;
            }

        .uploaded-images {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
            gap: 14px;
            margin-top: 18px;
        }

        .uploaded-img {
            position: relative;
            aspect-ratio: 4/3;
            border-radius: 10px;
            overflow: hidden;
            border: 2px solid var(--border);
        }

            .uploaded-img img {
                width: 100%;
                height: 100%;
                object-fit: cover;
            }

            .uploaded-img .remove-btn {
                position: absolute;
                top: 5px;
                right: 5px;
                background: var(--gold);
                color: var(--dark);
                border: none;
                width: 26px;
                height: 26px;
                border-radius: 50%;
                cursor: pointer;
            }

        .map-wrapper {
            position: relative;
            width: 100%;
            height: 65vh;
            min-height: 400px;
            border-radius: 12px;
            overflow: hidden;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.12);
            background: #e5e7eb;
        }

        #map {
            width: 100%;
            height: 100%;
            z-index: 1;
        }

        .coords-box {
            text-align: center;
            background: #e8e5cf69;
            padding: 16px 6px;
            border-radius: 10px;
            margin-top: 14px;
            display: flex;
            gap: 11px;
            flex-wrap: wrap;
            border: 1px solid #0f377e;
        }

        .coord-item {
            display: flex;
            flex-direction: column;
            gap: 5px;
            flex: 1;
            min-width: 282px;
        }

            .coord-item label {
                font-weight: 700;
                color: var(--dark);
                font-size: 1rem;
            }

            .coord-item span {
                font-family: "Courier New", monospace;
                font-size: 1.05rem;
                color: var(--dark);
                font-weight: 700;
                background: var(--white);
                padding: 7px 12px;
                border-radius: 7px;
                border: 1px solid var(--border);
            }

        .hawya {
            display: flex;
            align-items: center;
            gap: 60px;
            flex-wrap: wrap;
        }

        .amenities-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
            gap: 11px;
        }

        .amenity-item {
            display: flex;
            align-items: center;
            gap: 9px;
            padding: 13px 15px;
            background: var(--bg-light);
            border: 2px solid var(--border);
            border-radius: 10px;
            cursor: pointer;
            font-weight: 600;
            color: var(--dark);
        }

            .amenity-item input[type="checkbox"] {
                width: 19px;
                height: 19px;
                accent-color: #f7cc43;
                cursor: pointer;
            }

        .error-message {
            color: #dc3545;
            font-size: 0.85rem;
            margin-top: 4px;
            display: none;
        }

        .form-control.error {
            border-color: #dc3545 !important;
        }

        .control-container {
            position: absolute;
            top: 12px;
            left: 12px;
            z-index: 1000;
            background: #fff;
            border-radius: 8px;
            box-shadow: 0 2px 12px rgba(0, 0, 0, 0.15);
            padding: 4px;
            display: flex;
            gap: 4px;
        }

        .map-btn {
            border: none;
            background: transparent;
            padding: 10px 16px;
            font-size: 14px;
            font-weight: 500;
            color: #444;
            cursor: pointer;
            border-radius: 6px;
            display: flex;
            align-items: center;
            gap: 6px;
            transition: all 0.2s ease;
        }

            .map-btn:hover {
                background: #f5f5f5;
            }

            .map-btn.active {
                background: #e8f0fe;
                color: #1a73e8;
                font-weight: 600;
            }

        .fullscreen-btn {
            position: absolute;
            top: 1rem;
            right: 0.6rem;
            z-index: 1000;
            width: 35px;
            height: 35px;
            background: #fff;
            border: 2px solid #bababa;
            border-radius: 8px;
            box-shadow: 0 2px 12px rgba(0, 0, 0, 0.15);
            cursor: pointer;
        }

        .pegman-btn {
            position: absolute;
            bottom: 27px;
            right: 5px;
            z-index: 1000;
            width: 48px;
            height: 48px;
            background: #fff;
            border: none;
            border-radius: 8px;
            box-shadow: 0 3px 4px rgb(0 0 0);
            cursor: grab;
        }

        .btn-reset-location {
            font-family: "Tajawal", sans-serif;
            border: 2px solid #0f377e;
            border-radius: 15px;
            font-size: 1rem;
            color: #000000;
            background: #aacbc8;
            padding: 17px 23px;
            cursor: pointer;
            height: fit-content;
            margin-top: 14px;
            font-weight: 500;
        }

        .restart {
            flex: 0 0 auto;
        }

        .timeline-bg-line, .timeline-progress {
            position: absolute;
            width: 2px;
            border-radius: 1px;
            pointer-events: none;
            right: 21px;
        }

        .timeline-bg-line {
            background: var(--border);
        }

        .timeline-progress {
            background: var(--gold);
            height: 0;
            transition: height 0.35s cubic-bezier(0.4, 0, 0.2, 1);
            z-index: 1;
        }

        .scroll-top {
            color: #192e43;
            font-size: 18px;
            position: fixed;
            bottom: 21px;
            right: 26px;
            width: 44px;
            height: 44px;
            background: #ffffff;
            border: 3px solid #1a314d;
            border-radius: 50%;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            opacity: 0;
            visibility: hidden;
            transition: all 0.3s;
            z-index: 999;
        }

            .scroll-top.show {
                opacity: 1;
                visibility: visible;
            }

        .hidden {
            display: none !important;
        }

        @@media (max-width: 1200px) {
            .nav-links {
                padding: 0 8rem;
                gap: 40px;
            }

            .main-layout {
                flex-direction: column !important;
            }

            .steps-sidebar {
                width: 100% !important;
            }

            .steps-sticky {
                position: relative;
                top: 0;
            }

            .timeline {
                height: auto;
                flex-direction: row;
                flex-wrap: wrap;
                padding: 20px;
                gap: 10px;
                justify-content: center;
            }

            .timeline-bg-line, .timeline-progress {
                display: none;
            }

            .step {
                flex: 0 0 auto;
                padding: 10px 15px;
                background: var(--bg-light);
                border-radius: 10px;
                border: 2px solid transparent;
            }
        }

        @@media (max-width: 992px) {
            .navbar {
                justify-content: center;
                padding: 10px 15px;
            }

            .nav-links {
                padding: 0 2rem;
                gap: 25px;
            }

            .container {
                padding: 1.2rem;
            }

            .main-layout {
                flex-direction: column !important;
            }

            .steps-sidebar {
                width: 100% !important;
            }

            .steps-sticky {
                position: relative;
                top: 0;
            }

            .timeline {
                height: auto;
                flex-direction: row;
                flex-wrap: wrap;
                padding: 15px;
                gap: 8px;
                justify-content: center;
            }

            .timeline-bg-line, .timeline-progress {
                display: none;
            }

            .step {
                flex: 0 0 auto;
                padding: 8px 12px;
                background: var(--bg-light);
                border-radius: 8px;
                border: 2px solid transparent;
                gap: 10px;
            }
        }

        @@media (max-width: 768px) {
            .navbar {
                flex-direction: column;
                padding: 10px;
            }

            .nav-links {
                padding: 0;
                gap: 15px;
                flex-wrap: wrap;
            }

                .nav-links a {
                    font-size: 0.8rem;
                }

            .container {
                padding: 1rem;
            }

            .page-header {
                flex-direction: column;
                text-align: center;
            }

            .page-info {
                flex-direction: column;
                text-align: center;
            }

            .page-title h1 {
                font-size: 1.4rem;
            }

            .main-layout {
                flex-direction: column !important;
            }

            .steps-sidebar {
                width: 100% !important;
            }

            .steps-sticky {
                position: relative;
                top: 0;
            }

            .timeline {
                height: auto;
                flex-direction: row;
                flex-wrap: wrap;
                padding: 12px;
                gap: 6px;
                justify-content: center;
            }

            .timeline-bg-line, .timeline-progress {
                display: none;
            }

            .step {
                flex: 0 0 auto;
                padding: 6px 10px;
                background: var(--bg-light);
                border-radius: 8px;
                border: 2px solid transparent;
                gap: 8px;
            }

                .step .info-sub {
                    display: none;
                }

            .circle {
                width: 28px;
                height: 28px;
                font-size: 0.65rem;
            }

            .step.completed .circle {
                width: 32px;
                height: 32px;
            }

            .info-title {
                font-size: 0.75rem;
            }

            .card {
                padding: 16px;
            }

            .form-grid {
                grid-template-columns: 1fr;
                gap: 12px;
            }

            .form-actions {
                flex-direction: column;
                align-items: stretch;
            }

            .btn-group {
                justify-content: center;
            }

            .btn {
                padding: 10px 18px;
                font-size: 0.9rem;
                border-radius: 8px;
                justify-content: center;
            }

            .map-wrapper {
                height: 40vh;
                min-height: 250px;
            }

            .coords-box {
                padding: 12px 15px;
                gap: 12px;
            }

            .coord-item {
                min-width: 140px;
            }

            .amenities-grid {
                grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
                gap: 8px;
            }

            .upload-box {
                padding: 20px 15px;
            }

                .upload-box i {
                    font-size: 2rem;
                }

            .uploaded-images {
                grid-template-columns: repeat(auto-fill, minmax(100px, 1fr));
                gap: 10px;
            }
        }

        @@media (max-width: 480px) {
            .nav-links {
                gap: 8px;
            }

                .nav-links a {
                    font-size: 0.7rem;
                }

            .container {
                padding: 0.5rem;
            }

            .page-header {
                padding: 15px;
            }

            .page-title h1 {
                font-size: 1.2rem;
            }

            .timeline {
                padding: 8px;
                gap: 4px;
            }

            .step {
                padding: 4px 8px;
                gap: 6px;
            }

            .circle {
                width: 24px;
                height: 24px;
                font-size: 0.55rem;
            }

            .info-title {
                font-size: 0.65rem;
            }

            .card {
                padding: 12px;
            }

            .form-control {
                padding: 8px 10px;
                font-size: 0.8rem;
            }

            .coord-item {
                min-width: 100px;
            }

            .amenities-grid {
                grid-template-columns: 1fr 1fr;
                gap: 6px;
            }

            .uploaded-images {
                grid-template-columns: repeat(auto-fill, minmax(80px, 1fr));
                gap: 8px;
            }
        }
    </style>
</head>
<body>

    <nav class="navbar">
        <img class="logo" src="/image/hero.png" alt="SYRELIS" />
        <ul class="nav-links">
            <li><a href="/Home/Index?skipRedirect=true"><span class="link_span">الرئيسية</span></a></li>
            <li><a href="/Properties/Create">أعلن عن عقارك</a></li>
            <li><a href="/Search/Index"><span class="link_span">ابحث عن عقارك</span></a></li>
            <li><a href="@Url.Action("MyFavorites", "Properties")">محفوظاتي</a></li>
            <li><a href="/Home/Index?skipRedirect=true#contactSection" id="contactNavLink"><span class="link_span">تواصل معنا</span></a></li>
        </ul>
        <div class="navbar-right">
            @if (SignInManager.IsSignedIn(User))
            {
                var userName = User.Identity?.Name ?? "مستخدم";
                var firstLetter = userName.Length > 0 ? userName[0].ToString().ToUpper() : "?";
                <div class="user-avatar">
                    @firstLetter
                    <span class="tooltip">@userName</span>
                </div>
            }
            else
            {
                <button class="login-btn-nav" id="openModalBtn">
                    <i class="fas fa-sign-in-alt" style="margin-left: 6px;"></i> تسجيل الدخول
                </button>
            }
        </div>
    </nav>

    <div class="container">
        <partial name="_Tabs" />
        @if (TempData["Error"] != null)
        {
            <div class="error-msg" style="background:rgba(220,53,69,0.15); border:1px solid #dc3545; color:#dc3545; padding:12px 20px; border-radius:10px; text-align:center; margin-bottom:20px;">
                <i class="fa-solid fa-circle-exclamation"></i> @TempData["Error"]
            </div>
        }
        <div class="page-header">
            <div class="page-info">
                <a href="/" class="back-button"><i class="fas fa-arrow-right"></i></a>
                <div class="page-title">
                    <h1>أعلن عن عقارك</h1>
                    <p>انشر عقارك وسيتواصل معك المشترون المناسبون</p>
                </div>
            </div>
        </div>

        <div id="addProperty">
            <div class="main-layout">
                <aside class="steps-sidebar">
                    <div class="steps-sticky">
                        <div class="timeline" id="timeline">
                            <div class="timeline-bg-line" id="bgLine"></div>
                            <div class="timeline-progress" id="progress"></div>
                            <div class="step active" data-step="1">
                                <div class="circle"><span>1</span></div>
                                <div class="info">
                                    <div class="info-title">الوصف</div>
                                    <div class="info-sub">معلومات أساسية</div>
                                </div>
                            </div>
                            <div class="step" data-step="2">
                                <div class="circle"><span>2</span></div>
                                <div class="info">
                                    <div class="info-title">الوسائط</div>
                                    <div class="info-sub">صور وفيديو</div>
                                </div>
                            </div>
                            <div class="step" data-step="3">
                                <div class="circle"><span>3</span></div>
                                <div class="info">
                                    <div class="info-title">الموقع</div>
                                    <div class="info-sub">تحديد على الخريطة</div>
                                </div>
                            </div>
                            <div class="step" data-step="4">
                                <div class="circle"><span>4</span></div>
                                <div class="info">
                                    <div class="info-title">التفاصيل</div>
                                    <div class="info-sub">المواصفات الفنية</div>
                                </div>
                            </div>
                            <div class="step" data-step="5">
                                <div class="circle"><span>5</span></div>
                                <div class="info">
                                    <div class="info-title">المرافق</div>
                                    <div class="info-sub">الخدمات المتاحة</div>
                                </div>
                            </div>
                        </div>
                    </div>
                </aside>

                <div class="content-area">
                    <div class="card">
                        <form asp-action="Create" method="post" enctype="multipart/form-data" id="propForm">
                            @Html.AntiForgeryToken()

                            <!-- ====== الخطوة 1 ====== -->
                            <div class="form-step" data-step="1">
                                <div class="form-grid">
                                    <div class="form-group">
                                        <label>نوع العقار <span class="req">*</span></label>
                                        <select asp-for="PropertyTypeId" class="form-control" required>
                                            <option value="" disabled selected hidden>اختر النوع</option>
                                            @if (Model.PropertyTypes != null)
                                            {
                                                foreach (var type in Model.PropertyTypes)
                                                {
                                                    <option value="@type.Id">@type.NameAr</option>
                                                }
                                            }
                                        </select>
                                        <span class="field-hint">اختر نوع العقار المناسب</span>
                                        <span asp-validation-for="PropertyTypeId" class="error-message"></span>
                                    </div>

                                    <div class="form-group">
                                        <label>السعر$ <span class="req">*</span></label>
                                        <input asp-for="Price" type="number" class="form-control" placeholder="أدخل السعر" required min="0" />
                                        <span class="field-hint">أدخل سعر العقار بالدولار</span>
                                        <span asp-validation-for="Price" class="error-message"></span>
                                    </div>

                                    <div class="form-group full">
                                        <label>ضع عنوان مناسب للعقار <span class="req">*</span></label>
                                        <input asp-for="Title" class="form-control" placeholder="اكتب عنواناً مناسباً للعقار..." required />
                                        <span class="field-hint">عنوان مختصر وجذاب يعكس هوية العقار</span>
                                        <span asp-validation-for="Title" class="error-message"></span>
                                    </div>

                                    <div class="form-group full">
                                        <label>أضف تفاصيل إضافية (الوصف المفصل للعقار)</label>
                                        <textarea asp-for="Description" class="form-control" placeholder="اكتب وصفاً مفصلاً للعقار..."></textarea>
                                        <span class="field-hint">يمكنك إضافة تفاصيل إضافية عن العقار (اختياري)</span>
                                    </div>
                                </div>
                            </div>

                            <!-- ====== الخطوة 2 ====== -->
                            <div class="form-step hidden" data-step="2">
                                <div class="form-group">
                                    <label>الصورة الأساسية <span class="req">*</span></label>
                                    <div class="upload-box" onclick="document.getElementById('mainImg').click()">
                                        <i class="fa-solid fa-cloud-arrow-up"></i>
                                        <h4>اضغط لرفع الصورة الأساسية</h4>
                                        <p>يفضل صورة واضحة وذات جودة عالية</p>
                                        <input type="file" id="mainImg" name="MainImage" accept="image/*" hidden onchange="handleMainImg(this)" required />
                                    </div>
                                    <span class="field-hint">الصورة الأساسية تظهر كصورة الغلاف للعقار</span>
                                    <div id="mainImgPrev" class="uploaded-images"></div>
                                    <span asp-validation-for="MainImage" class="error-message" id="mainImgError"></span>
                                </div>

                                <div class="form-group" style="margin-top: 22px">
                                    <label>صور إضافية</label>
                                    <div class="upload-box" onclick="document.getElementById('propImgs').click()">
                                        <i class="fa-solid fa-images"></i>
                                        <h4>اضغط لرفع صور إضافية</h4>
                                        <p>يمكن اختيار أكثر من صورة</p>
                                        <input type="file" id="propImgs" name="AdditionalImages" accept="image/*" multiple hidden onchange="handlePropImgs(this)" />
                                    </div>
                                    <span class="field-hint">صور إضافية تعرض في معرض العقار (اختياري)</span>
                                    <div id="propImgsPrev" class="uploaded-images"></div>
                                </div>
                            </div>

                            <!-- ====== الخطوة 3 ====== -->
                            <div class="form-step hidden" data-step="3">
                                <div class="form-grid">
                                    <div class="form-group">
                                        <label>المدينة <span class="req">*</span></label>
                                        <select asp-for="CityId" class="form-control" id="citySelect" onchange="onCityChange(this.value)" required>
                                            <option value="" disabled selected hidden>اختر المدينة</option>
                                            @if (Model.Cities != null)
                                            {
                                                foreach (var city in Model.Cities)
                                                {
                                                    <option value="@city.Id">@city.NameAr</option>
                                                }
                                            }
                                        </select>
                                        <span class="field-hint">اختر المدينة التي يقع فيها العقار</span>
                                        <span asp-validation-for="CityId" class="error-message"></span>
                                    </div>

                                    <div class="form-group">
                                        <label>الحي <span class="req">*</span></label>
                                        <select asp-for="Neighborhood" class="form-control" id="neighborhoodSelect" onchange="onNeighborhoodChange(this.value)" required>
                                            <option value="" disabled selected hidden>اختر الحي</option>
                                        </select>
                                        <span class="field-hint">اختر الحي الذي يقع فيه العقار</span>
                                        <span asp-validation-for="Neighborhood" class="error-message"></span>
                                    </div>

                                    <div class="form-group full">
                                        <label>الشارع</label>
                                        <input asp-for="Address" class="form-control" placeholder="اسم الشارع" />
                                        <span class="field-hint">اسم الشارع (اختياري)</span>
                                    </div>

                                    <div class="form-group full">
                                        <label>ادخل الموقع التفصيلي للعقار <span class="req"></span></label>
                                        <textarea asp-for="DetailedLocation" class="form-control" placeholder="أدخل موقع العقار بالتفصيل..."></textarea>
                                        <span class="field-hint">وصف تفصيلي للموقع (مثل: بجانب مدرسة، مقابل حديقة)</span>
                                        <span asp-validation-for="DetailedLocation" class="error-message"></span>
                                    </div>

                                    <div class="form-group full map-section">
                                        <label>تحديد الموقع <span class="req">*</span></label>
                                        <p class="map-instructions">اسحب الرجل الأصفر وحدد موقعك بدقة</p>
                                        <span class="field-hint">حدد موقع العقار على الخريطة (يجب أن يكون داخل سوريا)</span>
                                        <div class="map-wrapper" id="mapWrapper">
                                            <div id="map"></div>
                                            <div class="control-container">
                                                <button type="button" class="map-btn active" onclick="setLayer('map')" id="btnMap">
                                                    <svg viewBox="0 0 24 24" width="16" height="16"><path d="M20.5 3l-.16.03L15 5.1 9 3 3.36 4.9c-.21.07-.36.25-.36.48V20.5c0 .28.22.5.5.5l.16-.03L9 18.9l6 2.1 5.64-1.9c.21-.07.36-.25.36-.48V3.5c0-.28-.22-.5-.5-.5zM15 19l-6-2.11V5l6 2.11V19z" /></svg>
                                                    خريطة
                                                </button>
                                                <button type="button" class="map-btn" onclick="setLayer('satellite')" id="btnSat">
                                                    <svg viewBox="0 0 24 24" width="16" height="16"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 17.93c-3.95-.49-7-3.85-7-7.93 0-.62.08-1.21.21-1.79L9 15v1c0 1.1.9 2 2 2v1.93zm6.9-2.54c-.26-.81-1-1.39-1.9-1.39h-1v-3c0-.55-.45-1-1-1H8v-2h2c.55 0 1-.45 1-1V7h2c1.1 0 2-.9 2-2v-.41c2.93 1.19 5 4.06 5 7.41 0 2.08-.8 3.97-2.1 5.39z" /></svg>
                                                    قمر صناعي
                                                </button>
                                            </div>
                                            <button type="button" class="fullscreen-btn" onclick="toggleFullscreen()" title="ملء الشاشة">
                                                <svg viewBox="0 0 24 24" width="20" height="20"><path d="M7 14H5v5h5v-2H7v-3zm-2-4h2V7h3V5H5v5zm12 7h-3v2h5v-5h-2v3zM14 5v2h3v3h2V5h-5z" /></svg>
                                            </button>
                                            <button type="button" class="pegman-btn" id="pegmanBtn" title="اسحب لتحديد الموقع">
                                                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 23 38" width="34" height="34"><path d="M16.6 38.1h-5.5l-.2-2.9-.2 2.9H5.2L5 25.3l-.8 2a1.53 1.53 0 01-1.9.9l-1.2-.4a1.58 1.58 0 01-1-1.9v-.1c.3-.9 3.1-11.2 3.1-11.2a2.66 2.66 0 012.3-2l.6-.5a6.93 6.93 0 014.7-12 6.8 6.8 0 014.9 2 7 7 0 012 4.9 6.65 6.65 0 01-2.2 5l.7.5a2.78 2.78 0 012.4 2s2.9 11.2 2.9 11.3a1.53 1.53 0 01-.9 1.9l-1.3.4a1.63 1.63 0 01-1.9-.9l-.7-1.8z" fill="#333" opacity=".7" /><path d="m5.9 13.6 1.1-.9h7.8l1.2.9" fill="#ce592c" /><ellipse cx="10.9" cy="13.1" rx="2.7" ry=".3" fill="#ce592c" opacity=".5" /><path d="m20.6 26.1-2.9-11.3a1.71 1.71 0 00-1.6-1.2H5.7a1.69 1.69 0 00-1.5 1.3L1.1 26.2a.61.61 0 00.3.7l1.1.4a.61.61 0 00.7-.3l2.7-6.7.2 16.8h3.6l.6-9.3a.47.47 0 01.44-.5h.06c.4 0 .4.2.5.5l.6 9.3h3.6l.2-16.8 2.5 6.6a.52.52 0 00.66.31l1.2-.4a.57.57 0 00.5-.7Z" fill="#fdbf2d" /><path d="m7 13.6 3.9 6.7 3.9-6.7" fill="#cf572e" opacity=".6" /><circle cx="10.9" cy="7" r="5.9" fill="#fdbf2d" /></svg>
                                            </button>
                                            <div id="dragIcon" aria-hidden="true" style="position: fixed; display: none; z-index: 9999; pointer-events: none;">
                                                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 23 38" width="52" height="52"><path d="M16.6 38.1h-5.5l-.2-2.9-.2 2.9H5.2L5 25.3l-.8 2a1.53 1.53 0 01-1.9.9l-1.2-.4a1.58 1.58 0 01-1-1.9v-.1c.3-.9 3.1-11.2 3.1-11.2a2.66 2.66 0 012.3-2l.6-.5a6.93 6.93 0 014.7-12 6.8 6.8 0 014.9 2 7 7 0 012 4.9 6.65 6.65 0 01-2.2 5l.7.5a2.78 2.78 0 012.4 2s2.9 11.2 2.9 11.3a1.53 1.53 0 01-.9 1.9l-1.3.4a1.63 1.63 0 01-1.9-.9l-.7-1.8z" fill="#333" opacity=".7" /><path d="m5.9 13.6 1.1-.9h7.8l1.2.9" fill="#ce592c" /><ellipse cx="10.9" cy="13.1" rx="2.7" ry=".3" fill="#ce592c" opacity=".5" /><path d="m20.6 26.1-2.9-11.3a1.71 1.71 0 00-1.6-1.2H5.7a1.69 1.69 0 00-1.5 1.3L1.1 26.2a.61.61 0 00.3.7l1.1.4a.61.61 0 00.7-.3l2.7-6.7.2 16.8h3.6l.6-9.3a.47.47 0 01.44-.5h.06c.4 0 .4.2.5.5l.6 9.3h3.6l.2-16.8 2.5 6.6a.52.52 0 00.66.31l1.2-.4a.57.57 0 00.5-.7Z" fill="#fdbf2d" /><path d="m7 13.6 3.9 6.7 3.9-6.7" fill="#cf572e" opacity=".6" /><circle cx="10.9" cy="7" r="5.9" fill="#fdbf2d" /></svg>
                                            </div>
                                        </div>

                                        <div class="hawya">
                                            <div class="coords-box">
                                                <div class="coord-item">
                                                    <label><i class="fa-solid fa-location-dot"></i> خط العرض</label>
                                                    <span id="latDisplay">--</span>
                                                </div>
                                                <div class="coord-item">
                                                    <label><i class="fa-solid fa-location-dot"></i> خط الطول</label>
                                                    <span id="lngDisplay">--</span>
                                                </div>
                                            </div>
                                            <div class="restart">
                                                <button type="button" class="btn-reset-location" onclick="resetLocation()">
                                                    <i class="fa-solid fa-rotate-right"></i>
                                                    <span>إعادة تعيين</span>
                                                </button>
                                            </div>
                                        </div>

                                        <input asp-for="Latitude" type="hidden" id="inputLat" />
                                        <input asp-for="Longitude" type="hidden" id="inputLng" />
                                        <span asp-validation-for="Latitude" class="error-message" id="mapError"></span>
                                    </div>
                                </div>
                            </div>

                            <!-- ====== الخطوة 4 ====== -->
                            <div class="form-step hidden" data-step="4">
                                <div class="form-grid">
                                    <div class="form-group">
                                        <label>رقم المحضر <span class="req">*</span></label>
                                        <input asp-for="PropertyNumber" type="number" class="form-control" placeholder="أدخل رقم المحضر" required min="1" />
                                        <span class="field-hint">رقم المحضر الخاص بالعقار</span>
                                        <span asp-validation-for="PropertyNumber" class="error-message"></span>
                                    </div>

                                    <div class="form-group">
                                        <label>المساحة (م²) <span class="req">*</span></label>
                                        <input asp-for="Area" type="number" class="form-control" placeholder="المساحة" required min="1" />
                                        <span class="field-hint">مساحة العقار بالمتر المربع</span>
                                        <span asp-validation-for="Area" class="error-message"></span>
                                    </div>

                                    <!-- ✅ جعل الغرف والحمامات مطلوبة -->
                                    <div class="form-group">
                                        <label>عدد الغرف <span class="req">*</span></label>
                                        <input asp-for="Rooms" type="number" class="form-control" placeholder="الغرف" required min="0" />
                                        <span class="field-hint">عدد الغرف (يجب أن يكون 0 أو أكثر)</span>
                                        <span asp-validation-for="Rooms" class="error-message"></span>
                                    </div>

                                    <div class="form-group">
                                        <label>عدد الحمامات <span class="req">*</span></label>
                                        <input asp-for="Bathrooms" type="number" class="form-control" placeholder="الحمامات" required min="0" />
                                        <span class="field-hint">عدد الحمامات (يجب أن يكون 0 أو أكثر)</span>
                                        <span asp-validation-for="Bathrooms" class="error-message"></span>
                                    </div>

                                    <div class="form-group">
                                        <label>رقم الطابق</label>
                                        <input asp-for="Floor" type="number" class="form-control" placeholder="رقم الطابق" min="-2" />
                                        <span class="field-hint">رقم الطابق (اختياري)</span>
                                    </div>

                                    <div class="form-group">
                                        <label>متاح من تاريخ <span class="req">*</span></label>
                                        <input asp-for="AvailableFrom" type="date" class="form-control" id="available_from" required />
                                        <span class="field-hint">التاريخ الذي يصبح فيه العقار متاحاً</span>
                                        <span asp-validation-for="AvailableFrom" class="error-message"></span>
                                    </div>

                                    <div class="form-group">
                                        <label>رقم الاتصال <span class="req">*</span></label>
                                        <input asp-for="AdvertiserPhone" type="tel" class="form-control" placeholder="09XXXXXXXX" required maxlength="10" />
                                        <span class="field-hint">رقم هاتف صالح للتواصل (يبدأ بـ 09)</span>
                                        <span asp-validation-for="AdvertiserPhone" class="error-message"></span>
                                    </div>
                                </div>
                            </div>

                            <!-- ====== الخطوة 5 ====== -->
                            <div class="form-step hidden" data-step="5">
                                <div class="form-group">
                                    <label>المرافق</label>
                                    <div class="amenities-grid">
                                        @if (Model.Features != null)
                                        {
                                            foreach (var feature in Model.Features)
                                            {
                                                <label class="amenity-item">
                                                    <input type="checkbox" name="FeatureIds" value="@feature.Id" />
                                                    <i class="fa-solid @(feature.IconClass ?? "fa-check")"></i> @feature.NameAr
                                                </label>
                                            }
                                        }
                                    </div>
                                    <span class="field-hint">اختر المرافق المتوفرة في العقار (اختياري)</span>
                                </div>
                            </div>

                            <!-- ====== أزرار التنقل ====== -->
                            <div class="form-actions">
                                <div class="btn-group">
                                    <button type="button" id="prevBtn" onclick="changeStep(-1)" class="btn btn-secondary" style="display: none">
                                        <i class="fa-solid fa-arrow-right"></i> السابق
                                    </button>
                                </div>
                                <div class="btn-group">
                                    <button type="button" id="nextBtn" onclick="changeStep(1)" class="btn btn-primary">
                                        التالي <i class="fa-solid fa-arrow-left"></i>
                                    </button>
                                    <button type="submit" id="pubBtn" class="btn btn-primary" style="display: none">
                                        ✓ نشر العقار
                                    </button>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <script>
        // ====== المتغيرات العامة ======
        let currentStep = 1;
        let map, currentMarker;
        let defaultCityId = 1; // حمص (Id=1 في قاعدة البيانات)

        // ====== مصفوفة حدود سوريا (كاملة) ======
